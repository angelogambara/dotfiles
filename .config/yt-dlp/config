# ########
# Output
# ########

# Prefix output with upload date and trim title
--output "%(upload_date>%Y-%m-%d)s - %(title).100B [%(id)s].%(ext)s"


# ########
# Format
# ########

# Keep the size small without lowering quality too much:
# - 720p@30fps/720p@60fps/1080p@30fps/1080p@60fps.
--format "(bv*[height=720][fps<=30]/bv*[height=720][fps=60]/bv*[height=1080][fps<=30]/bv*[height=1080][fps=60])+ba"

# Always merge into MKV (best for archival)
--merge-output-format mkv

# Embed chapters into the container
--embed-chapters

# Embed metadata (title, uploader, description, etc.)
--embed-metadata

# Save full metadata JSON per video (useful for preservation)
--embed-info-json

# Do NOT write extra playlist-level metadata files
--no-write-playlist-metafiles

# Embed thumbnail into the media file
--embed-thumbnail

# Convert thumbnails to JPEG before embedding
--convert-thumbnails jpg


# ########
# Subs
# ########

# Select live_chat_replay
--sub-langs live_chat_replay

# Embed live_chat_replay
--embed-subs

# Save subtitles in VTT format
--sub-format vtt


# ########
# Stream
# ########

# Write downloaded vides to archive file
--download-archive ~/.cache/yt-dlp/download-archive.txt

# Never overwrite files
--no-overwrites

# Report errors but don't stop
--ignore-errors

# Retry on failure
--retries 50

# Retry individual stream fragments
--fragment-retries 50
