customCommands:
  - key: "C"
    command: 'git commit -m "{{ .Form.Type }}{{if .Form.Scopes}}({{ .Form.Scopes }}){{end}}{{ .Form.Breaking }}: {{ .Form.Description }}"'
    description: "Commit changes using conventional commits"
    context: "files"
    prompts:
      - type: "menu"
        title: "Select Commit Type"
        key: "Type"
        options:
          - name: "Feature"
            description: "Introduces new functionality (triggers MINOR version)"
            value: "feat"
          - name: "Bug Fix"
            description: "Fixes a bug in production code (triggers PATCH version)"
            value: "fix"
          - name: "Performance"
            description: "Improves performance without changing behavior"
            value: "perf"
          - name: "Documentation"
            description: "Documentation changes only"
            value: "docs"
          - name: "Refactor"
            description: "Code change that neither fixes a bug nor adds a feature"
            value: "refactor"
          - name: "Styling"
            description: "Formatting, missing semi-colons, linting (no code logic changes)"
            value: "style"
          - name: "Test"
            description: "Adding missing tests or correcting existing tests"
            value: "test"
          - name: "Build"
            description: "Changes affecting build system or external dependencies"
            value: "build"
          - name: "CI"
            description: "Changes to CI configuration files and scripts"
            value: "ci"
          - name: "Maintenance"
            description: "Other changes that don't modify src or test files"
            value: "chore"
          - name: "WIP"
            description: "Save changes to feature branch (do not use in production)"
            value: "wip"

      - type: "menu"
        title: "Is this a breaking change?"
        key: "Breaking"
        options:
          - name: "No"
            description: "Standard non-breaking change"
            value: ""
          - name: "Yes"
            description: "Breaks backward compatibility (triggers MAJOR version)"
            value: "!"

      - type: "input"
        title: "Optional scope (e.g., auth, billing, search, ui)"
        key: "Scopes"

      - type: "input"
        title: "Commit description (imperative, present tense)"
        key: "Description"

      - type: "confirm"
        title: "Commit your changes?"
        body: "{{ .Form.Type }}{{if .Form.Scopes}}({{ .Form.Scopes }}){{end}}{{ .Form.Breaking }}: {{ .Form.Description }}"
