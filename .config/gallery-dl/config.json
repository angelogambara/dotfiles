{
	"extractor": {
		"base-directory": "~/gallery-dl",
		"cookies": ["firefox"],
		"pixiv": {
			"directory": ["{category}", "{user[id]}"]
		},
		"exhentai": {
			"directory": ["{category}", "g", "{gid}", "{token}"]
		},
		"user-agent": "Mozilla/5.0 (X11; Linux x86_64; rv:153.0) Gecko/20100101 Firefox/153.0"
	}
}
