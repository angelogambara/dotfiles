#!/bin/sh

# =========================
# Preparation
# =========================

# Always set to x11
export XDG_SESSION_TYPE=x11

# Detect XINITRC_HOME
if [ -n "$XINITRC" ]; then
  XINITRC_HOME=$(dirname "$XINITRC")
else
  XINITRC_HOME=$HOME
fi

# =========================
# Run Parts
# =========================

# Source each file in order
if [ -d "$XINITRC_HOME"/xinitrc.d ]; then
  for f in "$XINITRC_HOME"/xinitrc.d/?*.sh; do
    # shellcheck disable=1090
    [ -x "$f" ] && . "$f"
  done
  unset f
fi

# =========================
# Window Manager
# =========================

# Set to the name of your window manager
export XDG_CURRENT_DESKTOP=dwm

# Replace shell with window manager
exec dwm >/tmp/dwm.log 2>&1
