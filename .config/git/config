[alias]
    rbau = rebase -i --exec 'git commit --amend --no-edit --reset-author'
    rbgs = rebase -i --exec 'git commit --amend --no-edit --gpg-sign'

[commit]
    gpgsign = true

[core]
    autocrlf = input
    pager = delta

[delta]
    side-by-side = true

[fetch]
    prune = true

[init]
    defaultBranch = main

[merge]
    conflictstyle = zdiff3

[pull]
    rebase = true

[push]
    autoSetupRemote = true

