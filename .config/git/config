[include]
    path = ~/.config/delta/themes.gitconfig

[alias]
    rebase = !git rebase --committer-date-is-author-date
    rbauthor = !git rebase -i --committer-date-is-author-date --exec 'git commit --amend --no-edit --reset-author --gpg-sign'
    rbcommit = !git rebase -i --committer-date-is-author-date --exec 'git commit --amend --no-edit --reset-author --gpg-sign --date="$(date -R)"'
    rbdate   = !git rebase -i --committer-date-is-author-date --exec 'git commit --amend --no-edit --date="$(date -R)"'

[commit]
    gpgsign = true
    verbose = true

[core]
    autocrlf = input
    hooksPath = .githooks
    pager = delta

[delta]
    features = mellow-barbet
    navigate = true
    side-by-side = true
    syntax-theme = gruvbox-dark

[fetch]
    prune = true

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[merge]
    conflictstyle = zdiff3

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[rerere]
    enabled = true

[tag]
    gpgsign = true

[user]
    email = angelogambaradev@noreply.codeberg.org
    name = Angelo Gambara
