[alias]
    rebase = !git rebase --committer-date-is-author-date
    reauthor = !git rebase -i --committer-date-is-author-date --exec 'git commit --amend --no-edit --reset-author --gpg-sign'
    recommit = !git rebase -i --committer-date-is-author-date --exec 'git commit --amend --no-edit --reset-author --gpg-sign --date="$(date -R)"'
    redate   = !git rebase -i --committer-date-is-author-date --exec 'git commit --amend --no-edit --date="$(date -R)"'

[commit]
    gpgsign = true

[core]
    autocrlf = input
    hooksPath = .githooks
    pager = delta

[delta]
    side-by-side = true

[fetch]
    prune = true

[init]
    defaultBranch = main

[merge]
    conflictstyle = zdiff3

[pull]
    rebase = true

[push]
    autoSetupRemote = true

