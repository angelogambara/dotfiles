[alias]
    gpglg = log --all --graph --decorate --show-signature
    resign-repo = rebase --exec 'git commit --amend --no-edit --no-date -S'

[commit]
    gpgsign = true

[core]
    autocrlf = input
    pager = delta

[delta]
    side-by-side = true

[fetch]
    prune = true

[init]
    defaultBranch = main

[merge]
    conflictstyle = zdiff3

[pull]
    rebase = true

[push]
    autoSetupRemote = true

