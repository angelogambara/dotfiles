#!/bin/sh
# Launch instances of melonDS attached to unique save file

# ########
# Prep
# ########

# Exit on failure
set -e

# Arbitrary number to stop loop from running indefinitely
MAX_INSTANCES=12

# Number of times to loop
NUMBER=1

# Emulator of choice
EMULATOR=melonDS

# Prettier error messages
SCRIPT_BASENAME="$(basename "$0")"

# Optional: backup files and directories
bak() {
  if [ "$#" -eq 0 ]; then
    echo >&2 'Usage: bak [FILE]...'
    return 1
  fi

  now=$(date +"%Y%m%d-%H%M%S")
  for f in "$@"; do
    f=${f%/}
    if [ -e "$f" ]; then
      mv -n "$f" "$f.$now.bak"
    else
      echo >&2 "bak: '$f': No such file or directory"
    fi
  done
}

# Check if values are integers
isint() {
  # Loop until no more arguments are left
  while [ -n "$1" ]; do
  # Ignore minus sign
  abs="${1#-}"

  # Match anything that isn't a number
  case "$abs" in
  *[!0-9]*)
    return 1
    ;;
  esac

  # Next argument
  shift
  done
}

# ########
# Arguments
# ########

# Loop until '--'
while [ -n "$1" ] && [ "$1" != '--' ]; do
  # Match the current argument
  case "$1" in
  -m | --max-instances)
    # Next argument is the instance count
    shift

    # Get it
    MAX_INSTANCES="$1"
    ;;
  -n | --number)
    # Next argument is the number
    shift

    # Get it
    NUMBER="$1"
    ;;
  -e | --emulator)
    # Next argument is the name of the emulator
    shift

    # Get it
    EMULATOR="$1"
    ;;
  esac

  # Next argument
  shift
done

# Shift '--'
shift 2>/dev/null

# ########
# Validate
# ########

# Numbers are expected to be integers
if isint "$MAX_INSTANCES" "$NUMBER" || true; then
  echo >&2 "$SCRIPT_BASENAME: ['$MAX_INSTANCES', '$NUMBER']: Not an integer"
  exit 1
fi

# Get binary location
EMULATOR_BIN="$(which "$EMULATOR" 2> /dev/null || true)"

# Exit if specified emulator is not installed
if [ -z "$EMULATOR_BIN" ]; then
  echo >&2 "$SCRIPT_BASENAME: '$EMULATOR': Command not found"
  exit 1
fi

# ########
# ROM
# ########

#
# NOTE: We need to pass arguments, avoid shift.
#

# If melonDS, get second to last...
if [ "$EMULATOR" = 'melonDS' ]; then
  # Loop until 2rd to last argument
  while [ -n "$3" ]; do
    shift
  done

  # Next is the ROM, if and only if last is GBA
  ROM="$1"

  # Test
  if [ ! -r "$ROM" ]; then
    # Last chance
    ROM="$2"
  fi
else
  # Loop until last argument
  while [ -n "$2" ]; do
    shift
  done

  # Next is the ROM
  ROM="$1"
fi

# ########
# Launch
# ########

# Terminate early
if [ -z "$ROM" ]; then
  # Launch without symlinks
  while [ "$cnt" -lt "$NUMBER" ] && [ "$cnt" -le "$MAX_INSTANCES" ]; do
    "$EMULATOR_BIN" "$@"
  done

  # We are done
  exit 0
fi

# Exit if ROM isn't readable
if [ ! -r "$ROM" ]; then
  echo >&2 "$SCRIPT_BASENAME: '$ROM': Cannot read file"
  exit 1
fi

# Get ROM's parent directory
PARENT_DIR="$(dirname "$(realpath "$ROM")")"

# # Exit if PARENT_DIR isn't writable
if [ ! -w "$PARENT_DIR" ]; then
  echo >&2 "$SCRIPT_BASENAME: '$PARENT_DIR': Cannot write to directory"
  exit 1
fi

# Name without extension
basename="$(basename "$ROM" '.nds')"
SAV="$basename.sav"

cnt=0
while [ "$cnt" -lt "$NUMBER" ] && [ "$cnt" -le "$MAX_INSTANCES" ]; do
  # Assign names depending on count
  if [ "$cnt" -eq 0 ]; then
    file="$ROM"
    save="$SAV"
  else
    file="$basename ($cnt).nds"
    save="$basename ($cnt).sav"
  fi

  # Save 
  [ -f "$save" ] && bak "$save"

  #
  if [ "$file" != "$ROM" ]; then
    # Create symlink
    [ ! -L "$file" ] && ln -s "$ROM" "$file"
    # Overwrite save file
    [ -f "$SAV" ] && cp -f "$SAV" "$save"
  fi

  # Launch
  "$EMULATOR_BIN" "$@"
done
