# ########
# DBus
# ########

# Bind the bus socket
USER_BUS="${DBUS_SESSION_BUS_ADDRESS#*=}"
if [ -S "$USER_BUS" ]; then
    BWRAP_ARGS+=(
        --setenv DBUS_SESSION_BUS_ADDRESS "$DBUS_SESSION_BUS_ADDRESS"
        --bind "$USER_BUS" "$USER_BUS"
    )
else
    echo >&2 "$0: '$USER_BUS': No such file or directory"
    exit 1
fi

# Bind the system bus socket
if [ -S /run/dbus/system_bus_socket ]; then
    BWRAP_ARGS+=(
        --ro-bind /run/dbus/system_bus_socket /run/dbus/system_bus_socket
    )
else
    echo >&2 "$0: '/run/dbus/system_bus_socket': No such file or directory"
    exit 1
fi

# /etc/machine-id -> /var/lib/dbus/machine-id
[ -f /var/lib/dbus/machine-id ] && BWRAP_ARGS+=(--ro-bind /var/lib/dbus/machine-id /var/lib/dbus/machine-id)

# Bind resolver directories
for dir in "${RESOLV_DIRS[@]}"; do
    [ -d "$dir" ] && BWRAP_ARGS+=(--ro-bind "$dir" "$dir")
done

# ########
# SSH
# ########

# Avoid exposing ~/.ssh/known_hosts
KNOWN_HOST_FILE="$XDG_STATE_HOME/nvim/known_hosts"

mkdir -pm 700 "${KNOWN_HOST_FILE%/*}"
touch "$KNOWN_HOST_FILE"
chmod 700 "$KNOWN_HOST_FILE"

# SSH command used to clone plugins (regardless of remote)
export GIT_SSH_COMMAND="ssh -F /dev/null -o UserKnownHostsFile=$KNOWN_HOST_FILE"

# This loop will run only the first time
for origin in "${ORIGINS[@]}"; do
    # Skip if known
    if ! grep -q "$origin" "$KNOWN_HOST_FILE"; then
        # Generate known
        ssh-keyscan "$origin" >>"$KNOWN_HOST_FILE"
    fi
done

# ########
# Users
# ########

# Bind the config dir (safe and always writable)
BWRAP_ARGS+=(--bind "$XDG_CONFIG_HOME" "$XDG_CONFIG_HOME")

# Bind all other XDG paths for dirs in DOTFILES
for basedir in "${XDG_BASE_DIRS[@]/"$XDG_CONFIG_HOME"/}"; do
    # Bind dotfile directory
    for dir in "${DOTFILES[@]}"; do
        # Do the thing
        if [ -d "$basedir/$dir" ]; then
            BWRAP_ARGS+=(--bind "$basedir/$dir" "$basedir/$dir")
        fi
    done
done

# Bind a dummy path on top of previous binds to effectively shadow the path
for basedir in "${XDG_BASE_DIRS[@]}"; do
    # Bind shadows directory
    for shadow in "${SHADOWS[@]}"; do
        # Do the thing
        if [ -d "$basedir/$shadow" ]; then
            BWRAP_ARGS+=(--bind /tmp "$basedir/$shadow")
        fi
    done
done

# ########
# Files
# ########

# Bind any parent directory of Neovim arguments
for f in "${@:-$PWD/README.md}"; do
    # Skip if it starts with -
    [[ "$f" == -* ]] && continue

    # Check if it's whitelisted
    for dir in "${WHITELISTED_DIRS[@]}"; do
        [[ -z "$dir" ]] && continue

        # Set whitelisted
        if [[ "$f" == "$dir"/* ]]; then
            whitelisted=1
            break
        fi
    done

    # Not whitelisted
    if [ -z "${whitelisted:-}" ]; then
        # Prevent running from very personal directories
        for dir in "${PERSONAL_DIRS[@]}"; do
            [[ -z "$dir" ]] && continue

            # Allow subdirectories of PERSONAL_DIRS
            if [[ "$f" != "$dir"/*/* && "$f" == "$dir"/* ]]; then
                echo >&2 "$0: '$f': This path exposes personal files. Bind a subdirectory."
                exit 1
            fi
        done

        # Stop user from binding direct child of HOME
        case "$f" in
        "$HOME"/*)
            case "${f#"$HOME"/}" in
            */*)
                ;;
            *)
                echo >&2 "$0: '$f': This path exposes personal files. Bind a subdirectory."
                exit 1
                ;;
            esac
            ;;
        / | /home | /home/*)
            echo >&2 "$0: '$f': This path exposes personal files. Bind a subdirectory."
            exit 1
            ;;
        esac
    fi

    # Do the thing (Allow binding child of HOME at your own risk)
    PARENT_DIR="$(dirname "$(realpath "$f")")"
    if [ -d "$PARENT_DIR" ]; then
        BWRAP_ARGS+=(--bind "$PARENT_DIR" "$PARENT_DIR")
    fi
done

# ########
# Arguments
# ########

# Store absolute paths BEFORE changing directory
args=()
for arg in "$@"; do
    # Leave options alone
    [[ "$arg" == -* ]] && args+=("$arg")

    # Resolve the absolute path based on cwd
    args+=("$(realpath -m "$arg")")
done

# Change directory so that telescope and neo-tree don't get confused
cd "$PARENT_DIR" >/dev/null 2>&1 || true

# ########
# Run
# ########

# Uncomment to see options (hidden verbose flag)
# printf '%s\n' "${BWRAP_ARGS[@]}"

# Keep child process running (exec triggers trap early)
bwrap "${BWRAP_ARGS[@]}" "$NEOVIM_BIN" "${args[@]}"
