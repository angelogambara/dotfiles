#!/usr/bin/env bash
# Launch Neovim in a sandboxed
#
# Warning: this script has been tested on Arch/Void Linux. I don't know if
# it will work on other distros or BSD derivatives.
#
# Contributions are welcome!

# ########
# Prep
# ########

# Exit if non-zero status or unset env
set -euo pipefail

# Only canonical binaries
PATH="/usr/local/bin:/usr/bin"

# Get the right nvim (not this script)
NEOVIM_BIN="$(command -v nvim || exit 1)"

# Root should not run a heavely modded neovim
[ "$USER" = 'root' ] && exec "$NEOVIM_BIN" -u NONE "$@"

# ########
# Config
# ########

# Configuration
PROJECT_ROOT=$HOME/git
SHELL_ROOT=$HOME/bin

# Always bind any directory in the XDG Base Directories
DOTFILES=(
    nvim
    zsh
    antidote
)

# Always shadow any directory in XDG Base Directories
SHADOWS=(
    # Set your browser directory here
    mozilla

    # Other outliers
    Signal
    heroic
)

# Needed to clone plugins without exposing SSH known hosts
ORIGINS=(
    codeberg.org
    github.com
    gitlab.com
)

# Array of directories to block (absolute paths)
PERSONAL_DIRS=(
    ~/Desktop
    ~/Documents
    ~/Downloads
    ~/Pictures
    ~/Videos
)

# Respect user defined XDGs
: "${XDG_CACHE_HOME:=$HOME/.cache}"
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"

# Store in a clean array
XDG_BASE_DIRS=(
    "$XDG_CACHE_HOME"
    "$XDG_CONFIG_HOME"
    "$XDG_DATA_HOME"
    "$XDG_RUNTIME_DIR"
    "$XDG_STATE_HOME"
)

# Wrapper array (XDGs and preconfigured paths)
WHITELISTED_DIRS=(
    "$PROJECT_ROOT"
    "$SHELL_ROOT"
    "${XDG_BASE_DIRS[@]}"
)

# Real locations of fake /etc/resolv.conf symlinks
RESOLV_DIRS=(
    /run/systemd/resolve
    /run/resolvconf
    /run/dhcpcd
    /run/NetworkManager
)

# ########
# Bwrap
# ########

# Start with a basic set of arguments
BWRAP_ARGS=(
    # System directories
    --ro-bind /usr /usr
    --ro-bind /sys /sys
    --ro-bind /etc /etc
    --proc /proc
    --dev /dev
    --bind /tmp /tmp

    # Preconfigured paths
    --bind "$PROJECT_ROOT" "$PROJECT_ROOT"
    --bind "$SHELL_ROOT" "$SHELL_ROOT"

    # Process and session isolation
    --unshare-pid
    --unshare-uts
    --unshare-ipc
    # --new-session
    --die-with-parent

    # Explicitly connect to network
    --share-net
)

# Symlink directories inside the sandbox
[ -d /lib ] && BWRAP_ARGS+=(--symlink /usr/lib /lib)
[ -d /lib64 ] && BWRAP_ARGS+=(--symlink /usr/lib64 /lib64)
[ -d /bin ] && BWRAP_ARGS+=(--symlink /usr/bin /bin)

# ########
# Display
# ########

# ==============================================================================
