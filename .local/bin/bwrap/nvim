#!/usr/bin/env bash
# Launch Neovim in a sandboxed
#
# Warning: this script has been tested on Arch/Void Linux. I don't know if
# it will work on other distros or BSD derivatives.
#
# Contributions are welcome!

# ########
# Prep
# ########

# Exit if non-zero status or unset env
set -euo pipefail

# Only canonical binaries
PATH="/usr/local/bin:/usr/bin"

# Get the right nvim (not this script)
NEOVIM_BIN="$(command -v nvim || exit 1)"

# Root should not run a heavely modded neovim
[ "$USER" = 'root' ] && exec "$NEOVIM_BIN" -u NONE "$@"

# ########
# Config
# ########

# Configuration
PROJECT_ROOT=$HOME/git
SHELL_ROOT=$HOME/bin

# Always bind any directory in the XDG Base Directories
DOTFILES=(
    nvim
    zsh
    antidote
)

# Always shadow any directory in XDG Base Directories
SHADOWS=(
    # Set your browser directory here
    mozilla

    # Other outliers
    Signal
    heroic
)

# Respect user defined XDGs
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"

# Needed to clone plugins without exposing SSH known hosts
PLUGIN_ORIGINS=(
    codeberg.org
    github.com
    gitlab.com
)

# Array of directories to block
PERSONAL_DIRS=(
    ~/Desktop
    ~/Documents
    ~/Downloads
    ~/Pictures
    ~/Videos
)

# Wrapper array (XDGs and preconfigured paths)
WHITELISTED_DIRS=(
    "$PROJECT_ROOT"
    "$SHELL_ROOT"
    "${XDG_BASE_DIRS[@]}"
)

# ########
# Bwrap
# ########

# Start with a basic set of arguments
BWRAP_ARGS=(
    # System directories
    --ro-bind /usr /usr
    --ro-bind /sys /sys
    --ro-bind /etc /etc
    --proc /proc
    --dev /dev
    --bind /tmp /tmp

    # Preconfigured paths
    --bind "$PROJECT_ROOT" "$PROJECT_ROOT"
    --bind "$SHELL_ROOT" "$SHELL_ROOT"

    # Process and session isolation
    --unshare-pid
    --unshare-uts
    --unshare-ipc
    # --new-session
    --die-with-parent

    # Explicitly connect to network
    --share-net
)

# FIX: Allow BSDs to bind as actual directories
# Optional: symlinks
[ -d /lib ] && BWRAP_ARGS+=(--symlink /usr/lib /lib)
[ -d /lib64 ] && BWRAP_ARGS+=(--symlink /usr/lib64 /lib64)
[ -d /bin ] && BWRAP_ARGS+=(--symlink /usr/bin /bin)

# ########
# Systemd
# ########

# Needed by systemd-resolvd stub to make DNS requests
[ -d /run/systemd/resolve ] && BWRAP_ARGS+=(--ro-bind /run/systemd/resolve /run/systemd/resolve)

# ########
# DBus
# ########

# Bind DBus socket
if [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    BWRAP_ARGS+=(--setenv DBUS_SESSION_BUS_ADDRESS "$DBUS_SESSION_BUS_ADDRESS")

    BWRAP_ARGS+=(
        --setenv XDG_RUNTIME_DIR "$XDG_RUNTIME_DIR"
        --bind "$XDG_RUNTIME_DIR/bus" "$XDG_RUNTIME_DIR/bus"
    )
else
    echo "Error: Couldn't find session dbus socket" >&2
    exit 1
fi

# Optional: System DBus Access
if [ -e /run/dbus/system_bus_socket ]; then
    BWRAP_ARGS+=(--ro-bind /run/dbus/system_bus_socket /run/dbus/system_bus_socket)
else
    echo "Warning: Couldn't find system bus socket" >&2
fi

# Also, bind the machine-id
if [ -f /var/lib/dbus/machine-id ]; then
    BWRAP_ARGS+=(--ro-bind /var/lib/dbus/machine-id /var/lib/dbus/machine-id)
fi

# ########
# Hosts
# ########

# Generate a read-only list of known hosts, to clone plugins from
# Parameters: list of FQDNs
git_ssh_prepare() {
    # Ensure parent direcotory exists
    : "${BWRAP_HOSTS:=$HOME/.ssh/bwrap_hosts}"
    mkdir -p -m 700 "${BWRAP_HOSTS%/*}"

    # Configure SSH line
    GIT_SSH_COMMAND="ssh -F /dev/null -o UserKnownHostsFile=$BWRAP_HOSTS"

    # This loop will run only as needed
    for website in "$@"; do
        # Skip if website is known
        if ! grep -q "$website" "$BWRAP_HOSTS"; then
            if ! ssh-keyscan "$website" >>"$BWRAP_HOSTS"; then
                echo >&2 "$0: $BWRAP_HOSTS: Write permission denied"
                exit 1
            fi
        fi
    done
}

# This may take a while the first time
# (Add sites to clone plugins from)
git_ssh_prepare "${PLUGIN_ORIGINS[@]}"

# ########
# XDGs
# ########

# Store in a clean array
XDG_BASE_DIRS=(
    "$XDG_CACHE_HOME"
    "$XDG_CONFIG_HOME"
    "$XDG_DATA_HOME"
    "$XDG_RUNTIME_DIR"
    "$XDG_STATE_HOME"
)

# Bind the config dir (safe and always writable)
BWRAP_ARGS+=(--bind "$XDG_CONFIG_HOME" "$XDG_CONFIG_HOME")

# Bind all other XDG paths for dirs in DOTFILES
for basedir in "${XDG_BASE_DIRS[@]/"$XDG_CONFIG_HOME"/}"; do
    # Bind dotfile directory
    for dir in "${DOTFILES[@]}"; do
        # Do the thing
        if [ -d "$basedir/$dir" ]; then
            BWRAP_ARGS+=(--bind "$basedir/$dir" "$basedir/$dir")
        fi
    done
done

# Bind a dummy path on top of previous binds to effectively shadow the path
for basedir in "${XDG_BASE_DIRS[@]}"; do
    # Bind shadows directory
    for shadow in "${SHADOWS[@]}"; do
        # Do the thing
        if [ -d "$basedir/$shadow" ]; then
            BWRAP_ARGS+=(--bind /tmp "$basedir/$shadow")
        fi
    done
done

# ########
# Files
# ########

# Bind any parent directory of Neovim arguments
for f in "$@"; do
    # Skip if it starts with -
    [[ "$f" == -* ]] && continue

    # Check if it's whitelisted
    for dir in "${WHITELISTED_DIRS[@]}"; do
        [[ -z "$dir" ]] && continue

        # Set whitelisted
        if [[ "$f" == "$dir"/* ]]; then
            whitelisted=1
            break
        fi
    done

    # Not whitelisted
    if [ -z "${whitelisted:-}" ]; then
        # Prevent running from very personal directories
        for dir in "${PERSONAL_DIRS[@]}"; do
            [[ -z "$dir" ]] && continue

            # Allow subdirectories of PERSONAL_DIRS
            if [[ "$f" != "$dir"/*/* && "$f" == "$dir"/* ]]; then
                echo >&2 "$0: $f: This path exposes personal files. Please, bind a subdirectory."
                exit 1
            fi
        done

        # FIX: Prevent from binding parent of ~/Downloads
        # Stop obvious blunders
        case "$f" in
        / | /home | /home/ | "$HOME" | "$HOME"/)
            echo >&2 "$0: $f: This path exposes personal files. Please, bind a subdirectory."
            exit 1
            ;;
        esac
    fi

    # Do the thing (Allow binding child of HOME at your own risk)
    PARENT_DIR="$(dirname "$(realpath "$f")")"
    if [ -d "$PARENT_DIR" ]; then
        BWRAP_ARGS+=(--bind "$PARENT_DIR" "$PARENT_DIR")
    fi
done

# ########
# Arguments
# ########

# Store absolute paths BEFORE changing directory
args=()
for arg in "$@"; do
    # Leave options alone
    [[ "$arg" == -* ]] && args+=("$arg")

    # Resolve the absolute path based on cwd
    args+=("$(realpath -m "$arg")")
done

# Change directory so that telescope and neo-tree don't get confused
cd "$PARENT_DIR" >/dev/null 2>&1 || true

# ########
# Run
# ########

# Uncomment to see options (hidden verbose flag)
printf '%s\n' "${BWRAP_ARGS[@]}"

# Keep child process running (exec triggers trap early)
bwrap "${BWRAP_ARGS[@]}" "$NEOVIM_BIN" "${args[@]}"
