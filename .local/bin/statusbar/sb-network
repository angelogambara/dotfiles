#!/bin/sh

# ########
# Helper
# ########

die() {
  echo >&2 "$1"
  exit 1
}

command_exists() {
  command -v "$@" >/dev/null 2>&1 || return 1
}

# ########
# Blocks
# ########

get_signal_strength() {
  command_exists iw || return 1

  iw dev "$ifname" link | awk '/signal/ {
      d=$2;
      q=2*(d+100);
      if(q>100) q=100; if(q<0) q=0;
      print q"%"
  }'
}

get_network() {
  icon="" # Network is down

  # Try Ethernet
  for e in /sys/class/net/e*; do
    [ -e "$e" ] || continue

    operstate=$(cat "$e"/operstate 2>/dev/null)

    if [ "$operstate" = 'up' ]; then
      icon="" # Connection is up
      break    # Buona la prima (take the first result)
    fi
  done

  # No Ethernet
  if [ "$icon" = "" ]; then
    # Try Wi-Fi
    for w in /sys/class/net/w*; do
      [ -e "$w" ] || continue

      operstate=$(cat "$w"/operstate 2>/dev/null)
      flags=$(cat "$w"/flags 2>/dev/null)

      if [ "$operstate" = 'up' ]; then
        ifname=${w##*/}
        if ! ping -c 1 archlinux.org >/dev/null; then
          icon="!" # Wi-Fi timeout
        elif strngth=$(get_signal_strength "$ifname"); then
          icon=" $strngth" # Strngth
        fi
      fi

      break # Buona la prima (take the first)
    done
  fi

  # Source theme
  . sb-theme

  # Display with theme
  [ -n "$icon" ] && echo "$theme $icon $reset"
}

# ########
# Main
# ########

# Refresh block
get_network
