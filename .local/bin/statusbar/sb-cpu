#!/bin/sh

# ########
# Helper
# ########

die() {
  echo >&2 "$1"
  exit 1
}

command_exists() {
  command -v "$@" >/dev/null 2>&1 || return 1
}

# ########
# Blocks
# ########

get_cpu() {
  # Temperature
  if grep -q Intel /proc/cpuinfo; then
    temp=$(sensors | awk '/Package id 0/ {print $4}')
  else
    temp=$(sensors | awk '/Tctl/ {print $2}')
  fi

  # Source theme
  . sb-theme

  # Display with theme
  echo "$theme  $temp $reset"
}

# ########
# Main
# ########

# Exit early if dependencies are missing
command_exists sensors || die "Error: sensors executable not found in PATH"

# Handle mouse clicks for the status bar (statuscmd patch for dwm)
case $BLOCK_BUTTON in
1) # Left click
  command_exists "$TERMINAL" && "$TERMINAL" -e watch -n 1 sensors
  ;;
3) # Left click
  command_exists "$TERMINAL" && "$TERMINAL" -e btop
  ;;
esac

# Refresh block
get_cpu
