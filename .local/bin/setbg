#!/bin/sh
# Set wallpaper (Wayland: swaybg, X11: feh)

# ########
# Arguments
# ########

# Exit on failure
set -e

# Where to store the wallpaper
WALLPAPER_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
mkdir -p "$WALLPAPER_DIR"

# The wallpaper location
WALLPAPER="$WALLPAPER_DIR/wallpaper"

# Fallback to current wallpaper
IMAGE="$WALLPAPER"

# ########
# Set
# ########

# Skip if no image is passed
if [ "$#" -eq 1 ]; then
  # Get path image (a.k.a, the new wallpaper)
  IMAGE="$(realpath "$1")" || exit 1
  if [ ! -f "$IMAGE" ]; then
    echo "Error: '$IMAGE': Image link is broken" >&2
    exit 1
  fi

  # Everything is good, set wallpaper
  ln -fs "$IMAGE" "$XDG_CACHE_HOME/wallpaper"
fi

# ########
# Display
# ########

# Choose your adventure based on the display proto
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  # Do this if running Wayland
  pkill -x swaybg
  exec swaybg -i "$IMAGE" -m fill >/dev/null 2>&1
else
  # Do this if on X11
  feh --no-fehbg --bg-fill "$IMAGE"
fi
